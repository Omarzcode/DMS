rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global Deny by Default ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Security Helper Functions ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isInitialAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.lower() == "omar.mo3031@gmail.com" ||
          request.auth.token.email.lower() == "mos.20122003@gmail.com"
        );
    }

    function preacherDoc(uid) {
      return get(/databases/$(database)/documents/preachers/$(uid));
    }

    function hasPreacherDoc(uid) {
      return exists(/databases/$(database)/documents/preachers/$(uid));
    }

    function getPreacherRole(uid) {
      return hasPreacherDoc(uid) ? preacherDoc(uid).data.role : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        isInitialAdmin() ||
        getPreacherRole(request.auth.uid) == 'admin'
      );
    }

    function isApprovedMember() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ── Preachers Collection ────────────────────────────────────────────────
    // Stores preacher profiles, roles ('admin', "da'i", 'pending')
    match /preachers/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidId(userId);

      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == userId
      );

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ── Beneficiaries Collection ────────────────────────────────────────────
    match /beneficiaries/{beneficiaryId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        isValidId(beneficiaryId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;

      allow update: if isSignedIn();

      allow delete: if isAdmin() || (isSignedIn() && resource.data.created_by == request.auth.uid);
    }

    // ── Attendance Collection ───────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        isValidId(attendanceId);

      allow update: if isSignedIn();

      allow delete: if isAdmin() || (isSignedIn() && resource.data.logged_by_id == request.auth.uid);
    }

    // ── Activities Collections (Maqari, Events, Lessons, Sections) ──────────
    match /maqari/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id);
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.creator_id == request.auth.uid);
    }

    match /events/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id);
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.creator_id == request.auth.uid);
    }

    match /lessons/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id);
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.creator_id == request.auth.uid);
    }

    match /sections/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id);
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.creator_id == request.auth.uid);
    }

    // ── 1-Level Folders Collection (e.g. Fall 25, Spring 26) ────────────────
    match /folders/{folderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(folderId);
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.creator_id == request.auth.uid);
    }
  }
}
